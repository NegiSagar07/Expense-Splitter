# ============================================================
# Expense Splitter — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER store real secrets in this file.
# ============================================================

# ----- Application -----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=3007
DEBUG=true

# ----- PostgreSQL (non-default port — we use 5487) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5487
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=expense_splitter_db
DATABASE_URL=postgresql+asyncpg://expense_user:your_strong_password_here@localhost:5487/expense_splitter_db

# ----- Security / JWT -----
SECRET_KEY=generate_with__openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
# Local frontend dev server: port 3007 (3000 and 5173 are taken by other projects)
# Replace the Render URL with your actual deployed URL after first deploy
ALLOWED_ORIGINS=http://localhost:3007,https://your-app-name.onrender.com

# ----- APScheduler -----
JOIN_REQUEST_EXPIRY_DAYS=7
